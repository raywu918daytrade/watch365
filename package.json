  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hyparquet": "^1.25.1",
    "hyparquet-compressors": "^1.1.1",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.46",
    "playwright": "^1.55.1",
    "tailwindcss": "^4.3.3"
  }
}
